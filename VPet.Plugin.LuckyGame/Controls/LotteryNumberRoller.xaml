<UserControl x:Class="VPet.Plugin.LuckyGame.Controls.LotteryNumberRoller"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NumberContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource DARKPrimaryTrans4}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DARKPrimaryLighter}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="80"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="ClipToBounds" Value="True"/>
            </Style>

            <Style x:Key="MainNumberTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                <Setter Property="FontSize" Value="45"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SpecialNumberTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                <Setter Property="FontSize" Value="40"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="HighlightNumberTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="Gold"/>
                <Setter Property="FontSize" Value="45"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Gold" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height=".5*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{ll:Str 主号码：}" Foreground="{DynamicResource DARKPrimaryText}" FontSize="24" Margin="20,5" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" FontWeight="Bold"/>

        <!-- 6个主号码 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="0">
            <!-- 主号码1 -->
            <Border x:Name="MainNumber1Border" Style="{StaticResource NumberContainerStyle}" 
                    BorderBrush="{DynamicResource SuccessBrush}" Margin="5,0">
                <Grid>
                    <TextBlock x:Name="MainNumber1Text" 
                                  Style="{StaticResource MainNumberTextStyle}"
                                  Text="0"/>
                </Grid>
            </Border>

            <!-- 主号码2 -->
            <Border x:Name="MainNumber2Border" Style="{StaticResource NumberContainerStyle}" 
                    BorderBrush="{DynamicResource SuccessBrush}" Margin="5,0">
                <Grid>
                    <TextBlock x:Name="MainNumber2Text" 
                                  Style="{StaticResource MainNumberTextStyle}"
                                  Text="0"/>
                </Grid>
            </Border>

            <!-- 主号码3 -->
            <Border x:Name="MainNumber3Border" Style="{StaticResource NumberContainerStyle}" 
                    BorderBrush="{DynamicResource SuccessBrush}" Margin="5,0">
                <Grid>
                    <TextBlock x:Name="MainNumber3Text" 
                                  Style="{StaticResource MainNumberTextStyle}"
                                  Text="0"/>
                </Grid>
            </Border>

            <!-- 主号码4 -->
            <Border x:Name="MainNumber4Border" Style="{StaticResource NumberContainerStyle}" 
                    BorderBrush="{DynamicResource SuccessBrush}" Margin="5,0">
                <Grid>
                    <TextBlock x:Name="MainNumber4Text" 
                                  Style="{StaticResource MainNumberTextStyle}"
                                  Text="0"/>
                </Grid>
            </Border>

            <!-- 主号码5 -->
            <Border x:Name="MainNumber5Border" Style="{StaticResource NumberContainerStyle}" 
                    BorderBrush="{DynamicResource SuccessBrush}" Margin="5,0">
                <Grid>
                    <TextBlock x:Name="MainNumber5Text" 
                                  Style="{StaticResource MainNumberTextStyle}"
                                  Text="0"/>
                </Grid>
            </Border>

            <!-- 主号码6 -->
            <Border x:Name="MainNumber6Border" Style="{StaticResource NumberContainerStyle}" 
                    BorderBrush="{DynamicResource SuccessBrush}" Margin="5,0">
                <Grid>
                    <TextBlock x:Name="MainNumber6Text" 
                                  Style="{StaticResource MainNumberTextStyle}"
                                  Text="0"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 分隔符 -->
        <TextBlock Text="+" 
                  FontSize="24" 
                  FontWeight="Bold"
                  Foreground="{DynamicResource DARKPrimaryText}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Margin="10,0"
                  Grid.Column="1" Grid.Row="1"/>

        <TextBlock Text="{ll:Str 副号码：}" Foreground="{DynamicResource DARKPrimaryText}" FontSize="24" Margin="20,5" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="2" FontWeight="Bold"/>

        <!-- 2个副号码 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="2">
            <!-- 副号码1 -->
            <Border x:Name="SpecialNumber1Border" Style="{StaticResource NumberContainerStyle}" 
                    BorderBrush="{DynamicResource DangerBrush}" Margin="5,0">
                <Grid>
                    <TextBlock x:Name="SpecialNumber1Text" 
                                  Style="{StaticResource SpecialNumberTextStyle}"
                                  Text="0"/>
                </Grid>
            </Border>

            <!-- 副号码2 -->
            <Border x:Name="SpecialNumber2Border" Style="{StaticResource NumberContainerStyle}" 
                    BorderBrush="{DynamicResource DangerBrush}" Margin="5,0">
                <Grid>
                    <TextBlock x:Name="SpecialNumber2Text" 
                                  Style="{StaticResource SpecialNumberTextStyle}"
                                  Text="0"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>