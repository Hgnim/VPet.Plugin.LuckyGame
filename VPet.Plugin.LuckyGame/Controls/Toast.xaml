<UserControl 
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="VPet.Plugin.LuckyGame.Controls.Toast"
    Width="Auto" Height="Auto"
    HorizontalAlignment="Left" VerticalAlignment="Top"
    Opacity="0"
    >
    <UserControl.Resources>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
    </UserControl.Resources>
    <Border x:Name="ToastBorder" 
        CornerRadius="8" 
        Background="{DynamicResource DARKPrimaryDarker}" 
        Padding="16,10">
        <TextBlock x:Name="MsgText" Text="test"
               Foreground="{DynamicResource DARKPrimaryText}" FontSize="14" TextWrapping="Wrap"/>
    </Border>
</UserControl>