<Window x:Class="VPet.Plugin.LuckyGame.Windows.Fortune"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        MinHeight="500" MinWidth="700" MaxHeight="600" MaxWidth="800" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        Title="{ll:Str 'Lucky Wheel'}" >
    <Window.Resources>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
    </Window.Resources>
    <Border Background="{DynamicResource DARKPrimaryTransA}" CornerRadius="10" ClipToBounds="True">
        <Grid MouseLeftButtonDown="DragArea_MouseLeftButtonDown" MouseMove="DragArea_MouseMove" MouseLeftButtonUp="DragArea_MouseLeftButtonUp">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width=".05*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <!-- 标题 -->
            <Border Grid.Row="0" Background="{DynamicResource DARKPrimaryDark}" 
                    BorderBrush="{DynamicResource DARKPrimaryLighter}" BorderThickness="0,0,0,2"
                    Margin="5,5,5,0" CornerRadius="5" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
                    <TextBlock Text="{ll:Str Lucky Wheel}" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          FontSize="28" FontWeight="Bold" 
                          Foreground="{DynamicResource DARKPrimaryText}"/>
                    <TextBlock Text="×" HorizontalAlignment="Right" VerticalAlignment="Center"
                        FontSize="28" FontWeight="Bold" FontStyle="Italic"
                        Background="Transparent" Foreground="{DynamicResource DARKPrimaryText}"
                        MouseLeftButtonDown="ExitButton_Click" Margin="0,0,10,0"/>
                </Grid>
            </Border>

            <!-- 设置容器 -->
            <Border x:Name="SettingBorder" Grid.Row="1" Margin="20" Background="{DynamicResource DARKPrimary}"
                    CornerRadius="10" BorderBrush="{DynamicResource DARKPrimaryLighter}" 
                    BorderThickness="2" Padding="10" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 设置标题 -->
                    <TextBlock Grid.Row="0" Text="{ll:Str 转盘选项}" 
                              FontSize="20" FontWeight="Bold"
                              Foreground="{DynamicResource DARKPrimaryText}"
                              HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- 设置项 -->
                    <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
                        <!-- 使用代币数量设置 -->
                        <Border Background="{DynamicResource DARKPrimaryTrans3}" 
                                CornerRadius="5" Padding="10" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{ll:Str 每次使用代币数量：}" 
                                          Foreground="{DynamicResource DARKPrimaryText}"
                                          FontSize="14" VerticalAlignment="Center"/>

                                <pu:NumberInput x:Name="TokenCostText" Grid.Column="1" 
                                        Value="10" Width="80" FontSize="14"
                                        Background="{DynamicResource DARKPrimaryTrans4}"
                                        Foreground="{DynamicResource DARKPrimaryText}"
                                        BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                        BorderThickness="1" Padding="5" Minimum="0"
                                        ValueChanged="TokenCostText_ValueChanged"/>
                            </Grid>
                        </Border>

                        <!-- 转盘格数设置 -->
                        <Border Background="{DynamicResource DARKPrimaryTrans3}" 
                                CornerRadius="5" Padding="10" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="79*"/>
                                    <ColumnDefinition Width="25*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{ll:Str 转盘格数：}" 
                                          Foreground="{DynamicResource DARKPrimaryText}"
                                          FontSize="14" VerticalAlignment="Center"/>

                                <ComboBox x:Name="SectorCountComboBox" Grid.Column="1" 
                                         Width="100" FontSize="14" SelectedIndex="0"
                                         Background="{DynamicResource DARKPrimaryTrans4}"
                                         Foreground="{DynamicResource DARKPrimaryText}"
                                         BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                         SelectionChanged="SectorCountComboBox_SelectionChanged">
                                    <ComboBoxItem Content="2格" Tag="2"/>
                                    <ComboBoxItem Content="4格" Tag="4" IsSelected="True"/>
                                    <ComboBoxItem Content="5格" Tag="5"/>
                                    <ComboBoxItem Content="6格" Tag="6"/>
                                    <ComboBoxItem Content="8格" Tag="8"/>
                                    <ComboBoxItem Content="10格" Tag="10"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- 预测点数设置 -->
                        <Border Background="{DynamicResource DARKPrimaryTrans3}" 
                                CornerRadius="5" Padding="10" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{ll:Str 预测点数：}" 
                                          Foreground="{DynamicResource DARKPrimaryText}"
                                          FontSize="14" VerticalAlignment="Center"/>

                                <pu:NumberInput x:Name="PredictionPointsText" Grid.Column="1" 
                                        Value="1" StepFactor="1" Width="80" FontSize="14"
                                        Background="{DynamicResource DARKPrimaryTrans4}"
                                        Foreground="{DynamicResource DARKPrimaryText}"
                                        BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                        BorderThickness="1" Padding="5" Minimum="1"
                                        ValueChanged="PredictionPointsText_ValueChanged"
                                        />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource DARKPrimaryTrans3}" 
                                CornerRadius="5" Padding="10" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{ll:Str 转盘调整：}" 
                                           Foreground="{DynamicResource DARKPrimaryText}"
                                           FontSize="14" VerticalAlignment="Center"/>
                                <Slider x:Name="NowAngleSilder" Grid.Column="1" VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True" Style="{DynamicResource StandardSliderStyle}"
                                        LargeChange=".5" Maximum="360" Minimum="0" Value="0"
                                        SmallChange=".01" TickFrequency="0.01"
                                        ValueChanged="NowAngleSilder_ValueChanged"/>
                            </Grid>
                        </Border>
                        <!--自动旋转设置-->
                        <Border Background="{DynamicResource DARKPrimaryTrans3}" 
                                CornerRadius="5" Padding="10" Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{ll:Str 自动旋转：}" 
                                    Foreground="{DynamicResource DARKPrimaryText}"
                                    FontSize="14" VerticalAlignment="Center"/>
                                <pu:Switch x:Name="AutoStartSwitch" Grid.Column="1" Background="Transparent"
                                        BorderBrush="{DynamicResource PrimaryDark}" BoxHeight="18" BoxWidth="40"
                                        CheckedBackground="{DynamicResource Primary}"
                                        CheckedBorderBrush="{DynamicResource Primary}"
                                        CheckedToggleBrush="{DynamicResource DARKPrimaryText}" 
                                        ToggleBrush="{DynamicResource PrimaryDark}" ToggleShadowColor="{x:Null}"
                                        FontSize="14"
                                        Checked="AutoStartSwitch_CheckedChange" Unchecked="AutoStartSwitch_CheckedChange" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 转盘容器 -->
            <Border x:Name="WheelBorder" Grid.Row="1" Margin="20" Background="{DynamicResource DARKPrimary}" 
                    CornerRadius="10" BorderBrush="{DynamicResource DARKPrimaryLighter}" 
                    BorderThickness="2" Padding="10" Visibility="Visible" Grid.Column="0">
                <Grid>
                    <!-- 转盘区域（可旋转的部分） -->
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="WheelCanvas" Width="400" Height="400">
                            <!-- 转盘外圈 -->
                            <Ellipse Canvas.Left="40" Canvas.Top="40" Width="320" Height="320" 
                                    Stroke="{DynamicResource DARKPrimaryLighter}" StrokeThickness="8"
                                    Fill="Transparent"/>

                            <!-- 转盘底座 -->
                            <Ellipse Canvas.Left="50" Canvas.Top="50" Width="300" Height="300" 
                                    Fill="{DynamicResource DARKPrimaryTrans3}"
                                    Stroke="{DynamicResource DARKPrimaryLighter}" StrokeThickness="3"/>

                            <!-- 扇形区域背景（将通过代码动态生成） -->

                            <!-- 装饰圆环 -->
                            <Ellipse Canvas.Left="80" Canvas.Top="80" Width="240" Height="240" 
                                    Stroke="{DynamicResource DARKPrimary}" StrokeThickness="2"
                                    Fill="Transparent"/>

                            <!-- 中心圆装饰 -->
                            <Ellipse Canvas.Left="175" Canvas.Top="175" Width="50" Height="50" 
                                    Fill="{DynamicResource DARKPrimaryDark}" 
                                    Stroke="{DynamicResource DARKPrimaryLighter}" StrokeThickness="2"/>

                            <!-- 中心圆 -->
                            <Ellipse Canvas.Left="190" Canvas.Top="190" Width="20" Height="20" 
                                    Fill="{DynamicResource DangerBrush}"
                                    Stroke="{DynamicResource DARKPrimaryText}" StrokeThickness="1"/>
                        </Canvas>
                    </Viewbox>

                    <!-- 固定指针（不随转盘旋转） -->
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="400" Height="400">
                            <!-- 指针底座 -->
                            <Ellipse Canvas.Left="195" Canvas.Top="10" Width="10" Height="10" 
                                    Fill="{DynamicResource DARKPrimaryLighter}"/>

                            <!-- 修正箭头方向：指向下方 -->
                            <Polygon Points="200,50 190,10 210,10" 
                                    Fill="{DynamicResource DangerBrush}"
                                    Stroke="{DynamicResource DARKPrimaryText}" StrokeThickness="1"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="CoinResult"
                            Foreground="{DynamicResource DARKPrimaryText}" HorizontalAlignment="Center"
                            FontSize="16" VerticalAlignment="Bottom" Height="auto" Margin="0,0,0,0"/>
                </Grid>
            </Border>

            <!-- 控制按钮和信息面板 -->
            <Grid Grid.Row="2" Background="{DynamicResource DARKPrimaryTrans2}" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CoinBalanceText" Text="🎮 ? 枚" 
                    Foreground="#FFFF00FF" FontSize="18" FontWeight="Bold"
                    HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!-- 控制按钮 -->
                <StackPanel x:Name="ControlPanel" Grid.Column="1" Orientation="Horizontal" 
                           HorizontalAlignment="Center" Margin="10,5" Visibility="Visible">
                    <Button x:Name="SpinButton" Content="{ll:Str 开始旋转}" 
                           Click="SpinButton_Click" Padding="20,8" Margin="5" 
                           Background="{DynamicResource SuccessBrush}" 
                           Foreground="{DynamicResource DARKPrimaryText}" 
                           FontWeight="Bold" FontSize="12" MinWidth="80"/>

                    <Button x:Name="ResetButton" Content="{ll:Str 重置}" 
                           Click="ResetButton_Click" Padding="20,8" Margin="5" 
                           Background="{DynamicResource WarningBrush}" 
                           Foreground="{DynamicResource DARKPrimaryText}" 
                           FontWeight="Bold" FontSize="12" MinWidth="80"/>
                </StackPanel>
            </Grid>
            <Button x:Name="helpButton" 
                    Width="24" Height="24" ToolTip="帮助" 
                    HorizontalAlignment="Left" Margin="16,0,0,0"
                    Click="HelpButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="helpButton_grid">
                                        <Ellipse Fill="{TemplateBinding Background}"/>
                                        <Viewbox Width="24" Height="24">
                                            <Canvas Width="512" Height="512">
                                                <Path Fill="White" 
                                          Data="M437.016,74.984c-99.979-99.979-262.075-99.979-362.033,0.002c-99.978,99.978-99.978,262.073,0.004,362.031 c99.954,99.978,262.05,99.978,362.029-0.002C536.995,337.059,536.995,174.964,437.016,74.984z M406.848,406.844 c-83.318,83.318-218.396,83.318-301.691,0.004c-83.318-83.299-83.318-218.377-0.002-301.693 c83.297-83.317,218.375-83.317,301.691,0S490.162,323.549,406.848,406.844z"/>
                                                <Path Fill="White" 
                                          Data="M271.295,86.684c-53.025-9.308-100.632,31.063-100.632,83.987c0,11.782,9.551,21.333,21.333,21.333 s21.333-9.551,21.333-21.333c0-26.507,23.776-46.67,50.584-41.964c16.882,2.968,31.079,17.165,34.048,34.052 c3.299,18.783-5.487,36.533-21.417,45.315c-26.377,14.544-41.882,43.645-41.882,74.746v37.184 c0,11.782,9.551,21.333,21.333,21.333c11.782,0,21.333-9.551,21.333-21.333V282.82c0-16.217,7.725-30.716,19.816-37.382 c31.705-17.479,49.333-53.091,42.839-90.063C333.906,120.803,305.864,92.761,271.295,86.684z"/>
                                                <Path Fill="White" 
                                          Data="M255.996,384.004c-11.776,0-21.333,9.557-21.333,21.333s9.557,21.333,21.333,21.333c11.776,0,21.333-9.557,21.333-21.333 S267.772,384.004,255.996,384.004z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="helpButton_grid" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="helpButton_grid" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>