<Window x:Class="VPet.Plugin.LuckyGame.Windows.ArcadeExchange"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        xmlns:controls="clr-namespace:VPet.Plugin.LuckyGame.Controls"
        Height="Auto" Width="Auto" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        Background="Transparent"
        pu:CornerRadiusAnimationHelper.CurrentCornerRadius="3"
        Title="{ll:Str 'Token Exchangge'}" >
    <Window.Resources>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
    </Window.Resources>
    <Border Background="Transparent" CornerRadius="15" ClipToBounds="True">
        <Grid Background="Transparent"
              MouseLeftButtonDown="DragArea_MouseLeftButtonDown" MouseMove="DragArea_MouseMove" MouseLeftButtonUp="DragArea_MouseLeftButtonUp"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 标题 -->
            <Border Grid.Row="0" Background="{DynamicResource DARKPrimaryDarker}" 
                    BorderBrush="{DynamicResource DARKPrimaryTransE}" BorderThickness="0,0,0,3"
                    CornerRadius="10,10,0,0" Padding="20,15" Margin="5,5,5,0">
                <Grid>
                    <TextBlock Text="{ll:Str 代币兑换系统}" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              FontSize="28" FontWeight="Bold" 
                              Foreground="{DynamicResource DARKPrimaryText}"/>
                    <TextBlock Text="×" HorizontalAlignment="Right" VerticalAlignment="Center"
                            FontSize="28" FontWeight="Bold" FontStyle="Italic"
                            Background="Transparent" Foreground="{DynamicResource DARKPrimaryText}"
                            MouseLeftButtonDown="ExitButton_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource DARKPrimaryDarker}" 
                BorderBrush="{DynamicResource DARKPrimaryTransE}" BorderThickness="0,0,0,3"
                CornerRadius="0,0,10,10" Padding="20,15" Margin="5,0,5,5">
                <!-- 主内容区域 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 代币兑换 -->
                    <Border Grid.Column="0" Grid.Row="0" Background="#FF444444" 
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="3"
                        CornerRadius="8" Margin="5">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{ll:Str 🎯 代币兑换}" FontSize="20" FontWeight="Bold"
                                              Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,15,0,10"/>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{ll:Str 兑换数量}" FontSize="14" Grid.Column="0" 
                                       Foreground="{DynamicResource DARKPrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"
                                       TextBlock.FontWeight="Bold"/>
                                <pu:NumberInput x:Name="TokenAmountText" Grid.Column="1" 
                                                FontSize="12" Padding="8" MinWidth="50"
                                                Background="#FF555555" Foreground="#FFFFFF"
                                                Margin="15" ValueChanged="TokenAmountText_ValueChanged"
                                                Minimum="0" Maximum="18446744073709551615"/>
                                <TextBlock x:Name="TokenBlock" Text="{ll:Str 花费 ? 金钱}" FontSize="12" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                        Foreground="#FFFF00FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                <Button Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Content="{ll:Str 兑换}" 
                                               Click="TokenExchangeButton_Click"
                                               Background="{DynamicResource DARKPrimaryDark}" 
                                               Foreground="{DynamicResource DARKPrimaryText}"
                                               Padding="15,8" FontSize="12" FontWeight="Bold"
                                               Margin="15"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 代币回收 -->
                    <Border Grid.Column="1" Grid.Row="0" Background="#FF444444" 
                    BorderBrush="#FF00FF00" BorderThickness="3"
                    CornerRadius="8" Margin="5">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{ll:Str $ 代币回收}" FontSize="20" FontWeight="Bold"
                                  Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,15,0,10"/>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <pu:NumberInput x:Name="MoneyText" Grid.Column="1" Grid.Row="0" 
                                    FontSize="12" Padding="8" MinWidth="50"
                                    Background="#FF555555" Foreground="#FFFFFF"
                                    Margin="15" Minimum="0" ValueChanged="MoneyText_ValueChanged" Maximum="18446744073709551615"/>
                                <TextBlock Text="{ll:Str 回收数量}" FontSize="14" Grid.Column="0" 
                                   Foreground="{DynamicResource DARKPrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"
                                   TextBlock.FontWeight="Bold"/>
                                <TextBlock x:Name="MoneyBlock" Text="{ll:Str 获得 ? 金钱}" FontSize="12" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                   Foreground="#FF00FF00" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                <Button Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Content="{ll:Str 回收}" 
                                   Click="MoneyExchangeButton_Click"
                                   Background="{DynamicResource DARKPrimaryDark}" 
                                   Foreground="{DynamicResource DARKPrimaryText}"
                                   Padding="15,8" FontSize="12" FontWeight="Bold"
                                   Margin="15"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 玩家信息 -->
                    <Border Grid.Column="0" Grid.Row="1" Background="#FF333333" 
                        BorderBrush="#FFFF9900" BorderThickness="3"
                        CornerRadius="8" Margin="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 用户信息标题 -->
                            <TextBlock Grid.Row="0" Text="{ll:Str 玩家信息}" 
                                  FontSize="20" FontWeight="Bold"
                                  Foreground="#FFFF9900"
                                  HorizontalAlignment="Center" Margin="0,15,0,0"/>

                            <!-- 用户资产信息 -->
                            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="20">
                                <!-- 现金余额 -->
                                <Border Background="#FF666666" CornerRadius="5" Padding="10" Margin="0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{ll:Str 金钱余额}" 
                                              Foreground="{DynamicResource DARKPrimaryText}" FontSize="14" Margin="0,10,20,10"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CashBalanceText" Text="$ ?" 
                                              Foreground="#FF00FF00" FontSize="16" FontWeight="Bold"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 代币数量 -->
                                <Border Background="#FF666666" CornerRadius="5" Padding="10" Margin="0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{ll:Str 代币数量}" 
                                              Foreground="{DynamicResource DARKPrimaryText}" FontSize="14" Margin="0,10,20,10"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CoinBalanceText" Text="🎮 ? 枚" 
                                              Foreground="#FFFF00FF" FontSize="16" FontWeight="Bold"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 代币选择 -->
                    <Border Grid.Column="1" Grid.Row="1" Background="#FF333333" 
                        BorderBrush="#FCB6FF" BorderThickness="3"
                        CornerRadius="8" Margin="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{ll:Str 代币选择}" 
                                FontSize="20" FontWeight="Bold"
                                Foreground="#FCB6FF"
                                HorizontalAlignment="Center" Margin="0,15,0,0"/>

                            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="20">
                                <ComboBox x:Name="CoinTypeSelect" 
                                          Background="#FF444444" Foreground="Gold"
                                          FontSize="14" Padding="8" Margin="0,10"
                                          SelectionChanged="CoinTypeSelect_SelectionChanged">
                                    <!--<ComboBoxItem>{ll:Str 黑色代币}</ComboBoxItem>
                                    <ComboBoxItem>{ll:Str 蓝色代币}</ComboBoxItem>
                                    <ComboBoxItem>{ll:Str 绿色代币}</ComboBoxItem>
                                    <ComboBoxItem>{ll:Str 红色代币}</ComboBoxItem>
                                    <ComboBoxItem>{ll:Str 白色代币}</ComboBoxItem>-->
                                </ComboBox>
                                <TextBlock x:Name="CoinTypeSelect_Lable" Text="{ll:Str 选择代币以显示其汇率}" 
                                           Foreground="{DynamicResource DARKPrimaryText}" FontSize="14" Margin="0,10,20,10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CoinTypeSelect_Lable2" Text="{ll:Str 选择代币以显示其回收手续费}" 
                                           Foreground="{DynamicResource DARKPrimaryText}" FontSize="14" Margin="0,10,20,10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Button x:Name="helpButton" 
                    Width="24" Height="24" ToolTip="帮助" 
                    HorizontalAlignment="Left" Margin="16,0,0,0"
                    Click="HelpButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="helpButton_grid">
                                        <Ellipse Fill="{TemplateBinding Background}"/>
                                        <Viewbox Width="24" Height="24">
                                            <Canvas Width="512" Height="512">
                                                <Path Fill="White" 
                                                      Data="M437.016,74.984c-99.979-99.979-262.075-99.979-362.033,0.002c-99.978,99.978-99.978,262.073,0.004,362.031 c99.954,99.978,262.05,99.978,362.029-0.002C536.995,337.059,536.995,174.964,437.016,74.984z M406.848,406.844 c-83.318,83.318-218.396,83.318-301.691,0.004c-83.318-83.299-83.318-218.377-0.002-301.693 c83.297-83.317,218.375-83.317,301.691,0S490.162,323.549,406.848,406.844z"/>
                                                <Path Fill="White" 
                                                      Data="M271.295,86.684c-53.025-9.308-100.632,31.063-100.632,83.987c0,11.782,9.551,21.333,21.333,21.333 s21.333-9.551,21.333-21.333c0-26.507,23.776-46.67,50.584-41.964c16.882,2.968,31.079,17.165,34.048,34.052 c3.299,18.783-5.487,36.533-21.417,45.315c-26.377,14.544-41.882,43.645-41.882,74.746v37.184 c0,11.782,9.551,21.333,21.333,21.333c11.782,0,21.333-9.551,21.333-21.333V282.82c0-16.217,7.725-30.716,19.816-37.382 c31.705-17.479,49.333-53.091,42.839-90.063C333.906,120.803,305.864,92.761,271.295,86.684z"/>
                                                <Path Fill="White" 
                                                      Data="M255.996,384.004c-11.776,0-21.333,9.557-21.333,21.333s9.557,21.333,21.333,21.333c11.776,0,21.333-9.557,21.333-21.333 S267.772,384.004,255.996,384.004z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="helpButton_grid" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="helpButton_grid" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <controls:Toast x:Name="Toast" 
                            Panel.ZIndex="100" Margin="0,0,0,24"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                            Grid.Row="1"/>
        </Grid>
    </Border>
</Window>