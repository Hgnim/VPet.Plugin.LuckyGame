<Window x:Class="VPet.Plugin.LuckyGame.Windows.ArcadeExchange"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="Auto" Width="Auto" WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource DARKPrimaryTrans4}">
    <Window.Resources>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 霓虹灯风格标题 -->
        <Border Grid.Row="0" Background="{DynamicResource DARKPrimaryDarker}" 
                BorderBrush="{DynamicResource DARKPrimaryTransE}" BorderThickness="0,0,0,3"
                CornerRadius="10,10,0,0" Padding="20,15">
            <Grid>
                <TextBlock Text="{ll:Str 代币兑换系统}" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          FontSize="28" FontWeight="Bold" 
                          Foreground="{DynamicResource DARKPrimaryText}"/>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Background="{DynamicResource DARKPrimaryDarker}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：游戏币展示和兑换区域 -->
            <Border Grid.Column="0" Background="#FF444444" 
                    BorderBrush="#FF00FF00" BorderThickness="3"
                    CornerRadius="8" Margin="10,5,5,5">
                    <!-- 自定义套餐 -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="🎯 代币兑换" FontSize="20" FontWeight="Bold"
                                          Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,15,0,10"/>
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".7*"/>
                                <ColumnDefinition Width=".3*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="CustomAmountText" Grid.Column="0" 
                                            Text="{ll:Str 输入金额}" FontSize="12" Padding="8"
                                            Background="#FF555555" Foreground="#FFFFFF"
                                            Margin="15"/>
                            <TextBlock x:Name="TenBlock" Text="{ll:Str 获得 ? 游戏币}" FontSize="14" Grid.Column="1" Grid.Row="0"
                                    Foreground="#FFFF00FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"/>
                            <Button Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Content="{ll:Str 兑换}" 
                                           Click="CustomExchangeButton_Click"
                                           Background="{DynamicResource DARKPrimaryDark}" 
                                           Foreground="{DynamicResource DARKPrimaryText}"
                                           Padding="15,8" FontSize="12" FontWeight="Bold"
                                           Margin="15"/>
                        </Grid>
                    </StackPanel>
            </Border>

            <!-- 右侧：用户信息和游戏展示 -->
            <Border Grid.Column="1" Background="#FF333333" 
                    BorderBrush="#FFFF9900" BorderThickness="3"
                    CornerRadius="8" Margin="5,5,10,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 用户信息标题 -->
                    <TextBlock Grid.Row="0" Text="{ll:Str 玩家信息}" 
                              FontSize="20" FontWeight="Bold"
                              Foreground="#FFFF9900"
                              HorizontalAlignment="Center" Margin="0,15,0,0"/>

                    <!-- 用户资产信息 -->
                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="20">
                        <!-- 现金余额 -->
                        <Border Background="#FF444444" CornerRadius="5" Padding="10" Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ll:Str 现金余额}" 
                                          Foreground="{DynamicResource DARKPrimaryText}" FontSize="14" Margin="0,10,20,10"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CashBalanceText" Text="$ ?" 
                                          Foreground="#FF00FF00" FontSize="16" FontWeight="Bold"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 游戏币数量 -->
                        <Border Background="#FF444444" CornerRadius="5" Padding="10" Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ll:Str 代币数量}" 
                                          Foreground="{DynamicResource DARKPrimaryText}" FontSize="14" Margin="0,10,20,10"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CoinBalanceText" Text="🎮 ? 枚" 
                                          Foreground="#FFFF00FF" FontSize="16" FontWeight="Bold"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作按钮 -->
        <Border Grid.Row="2" Background="#FF1A1A1A" 
                BorderBrush="#FF00FFFF" BorderThickness="0,3,0,0"
                CornerRadius="0,0,10,10" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="RefreshButton" Content="{ll:Str 🔄 刷新余额}" 
                        Click="RefreshButton_Click" 
                        Background="#FF00FFFF" Foreground="#000000"
                        Padding="20,10" FontSize="14" FontWeight="Bold" Margin="5"/>
                <Button x:Name="GameButton" Content="{ll:Str 🎮 游戏列表}" 
                        Click="GameButton_Click" 
                        Background="#FFFF9900" Foreground="#000000"
                        Padding="20,10" FontSize="14" FontWeight="Bold" Margin="5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>