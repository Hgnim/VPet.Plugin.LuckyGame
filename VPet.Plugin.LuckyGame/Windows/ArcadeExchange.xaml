<Window x:Class="VPet.Plugin.LuckyGame.Windows.ArcadeExchange"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        Height="Auto" Width="Auto" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        Background="Transparent"
        pu:CornerRadiusAnimationHelper.CurrentCornerRadius="3">
    <Window.Resources>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
    </Window.Resources>
    <Border Background="Transparent" CornerRadius="15" ClipToBounds="True">
        <Grid Background="Transparent"
              MouseLeftButtonDown="DragArea_MouseLeftButtonDown" MouseMove="DragArea_MouseMove" MouseLeftButtonUp="DragArea_MouseLeftButtonUp"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 标题 -->
            <Border Grid.Row="0" Background="{DynamicResource DARKPrimaryDarker}" 
                    BorderBrush="{DynamicResource DARKPrimaryTransE}" BorderThickness="0,0,0,3"
                    CornerRadius="10,10,0,0" Padding="20,15" Margin="5,5,5,0">
                <Grid>
                    <TextBlock Text="{ll:Str 代币兑换系统}" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              FontSize="28" FontWeight="Bold" 
                              Foreground="{DynamicResource DARKPrimaryText}"/>
                    <TextBlock Text="×" HorizontalAlignment="Right" VerticalAlignment="Center"
                            FontSize="28" FontWeight="Bold" FontStyle="Italic"
                            Background="Transparent" Foreground="{DynamicResource DARKPrimaryText}"
                            MouseLeftButtonDown="ExitButton_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource DARKPrimaryDarker}" 
                BorderBrush="{DynamicResource DARKPrimaryTransE}" BorderThickness="0,0,0,3"
                CornerRadius="0,0,10,10" Padding="20,15" Margin="5,0,5,5">
                <!-- 主内容区域 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 代币兑换 -->
                    <Border Grid.Column="0" Grid.Row="0" Background="#FF444444" 
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="3"
                        CornerRadius="8" Margin="5">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{ll:Str 🎯 代币兑换}" FontSize="20" FontWeight="Bold"
                                              Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,15,0,10"/>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{ll:Str 兑换数量}" FontSize="14" Grid.Column="0" 
                                       Foreground="{DynamicResource DARKPrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"
                                       TextBlock.FontWeight="Bold"/>
                                <pu:NumberInput x:Name="TokenAmountText" Grid.Column="1" 
                                                FontSize="12" Padding="8" MinWidth="50"
                                                Background="#FF555555" Foreground="#FFFFFF"
                                                Margin="15" ValueChanged="TokenAmountText_ValueChanged"
                                                Minimum="0"/>
                                <TextBlock x:Name="TokenBlock" Text="{ll:Str 花费 ? 金钱}" FontSize="12" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                        Foreground="#FFFF00FF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                <Button Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Content="{ll:Str 兑换}" 
                                               Click="TokenExchangeButton_Click"
                                               Background="{DynamicResource DARKPrimaryDark}" 
                                               Foreground="{DynamicResource DARKPrimaryText}"
                                               Padding="15,8" FontSize="12" FontWeight="Bold"
                                               Margin="15"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 代币回收 -->
                    <Border Grid.Column="1" Grid.Row="0" Background="#FF444444" 
                    BorderBrush="#FF00FF00" BorderThickness="3"
                    CornerRadius="8" Margin="5">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{ll:Str $ 代币回收}" FontSize="20" FontWeight="Bold"
                                  Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,15,0,10"/>
                            <Grid Margin="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <pu:NumberInput x:Name="MoneyText" Grid.Column="1" Grid.Row="0" 
                                    FontSize="12" Padding="8" MinWidth="50"
                                    Background="#FF555555" Foreground="#FFFFFF"
                                    Margin="15" Minimum="0" ValueChanged="MoneyText_ValueChanged"/>
                                <TextBlock Text="{ll:Str 回收数量}" FontSize="14" Grid.Column="0" 
                                   Foreground="{DynamicResource DARKPrimaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"
                                   TextBlock.FontWeight="Bold"/>
                                <TextBlock x:Name="MoneyBlock" Text="{ll:Str 获得 ? 金钱}" FontSize="12" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                   Foreground="#FF00FF00" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                <Button Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Content="{ll:Str 回收}" 
                                   Click="MoneyExchangeButton_Click"
                                   Background="{DynamicResource DARKPrimaryDark}" 
                                   Foreground="{DynamicResource DARKPrimaryText}"
                                   Padding="15,8" FontSize="12" FontWeight="Bold"
                                   Margin="15"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 玩家信息 -->
                    <Border Grid.Column="0" Grid.Row="1" Background="#FF333333" 
                        BorderBrush="#FFFF9900" BorderThickness="3"
                        CornerRadius="8" Margin="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 用户信息标题 -->
                            <TextBlock Grid.Row="0" Text="{ll:Str 玩家信息}" 
                                  FontSize="20" FontWeight="Bold"
                                  Foreground="#FFFF9900"
                                  HorizontalAlignment="Center" Margin="0,15,0,0"/>

                            <!-- 用户资产信息 -->
                            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="20">
                                <!-- 现金余额 -->
                                <Border Background="#FF444444" CornerRadius="5" Padding="10" Margin="0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{ll:Str 金钱余额}" 
                                              Foreground="{DynamicResource DARKPrimaryText}" FontSize="14" Margin="0,10,20,10"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CashBalanceText" Text="$ ?" 
                                              Foreground="#FF00FF00" FontSize="16" FontWeight="Bold"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 代币数量 -->
                                <Border Background="#FF444444" CornerRadius="5" Padding="10" Margin="0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{ll:Str 代币数量}" 
                                              Foreground="{DynamicResource DARKPrimaryText}" FontSize="14" Margin="0,10,20,10"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CoinBalanceText" Text="🎮 ? 枚" 
                                              Foreground="#FFFF00FF" FontSize="16" FontWeight="Bold"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>