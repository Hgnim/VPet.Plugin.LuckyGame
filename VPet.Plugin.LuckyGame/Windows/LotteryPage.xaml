<Window x:Class="VPet.Plugin.LuckyGame.Windows.LotteryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        xmlns:controls="clr-namespace:VPet.Plugin.LuckyGame.Controls"
        MinHeight="500" MinWidth="700" MaxHeight="800" MaxWidth="800" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        Title="{ll:Str 'Lottery'}" >
    <Window.Resources>
        <ResourceDictionary Source="/VPet-Simulator.Windows.Interface;component/ResourceStyle.xaml" />
    </Window.Resources>
    <Border Background="{DynamicResource DARKPrimaryTransA}" CornerRadius="10" ClipToBounds="True">
        <Grid MouseLeftButtonDown="DragArea_MouseLeftButtonDown" MouseMove="DragArea_MouseMove" MouseLeftButtonUp="DragArea_MouseLeftButtonUp">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Border Grid.Row="0" Background="{DynamicResource DARKPrimaryDark}" 
                    BorderBrush="{DynamicResource DARKPrimaryLighter}" BorderThickness="0,0,0,2"
                    Margin="5,5,5,0" CornerRadius="5">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="{ll:Str Ris彩票}" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          FontSize="28" FontWeight="Bold" 
                          Foreground="{DynamicResource DARKPrimaryText}"/>
                    <TextBlock Text="×" HorizontalAlignment="Right" VerticalAlignment="Center"
                        FontSize="28" FontWeight="Bold" FontStyle="Italic"
                        Background="Transparent" Foreground="{DynamicResource DARKPrimaryText}"
                        MouseLeftButtonDown="ExitButton_Click" Margin="0,0,10,0"/>
                </Grid>
            </Border>

            <!-- 主要内容区域 -->
            <Border Grid.Row="1" Margin="20" Background="{DynamicResource DARKPrimary}"
                    CornerRadius="10" BorderBrush="{DynamicResource DARKPrimaryLighter}" 
                    BorderThickness="2" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 游戏说明 -->
                    <TextBlock Grid.Row="0" Text="{ll:Str 选择6个主号码（0-30）和2个副号码（0-9）}"
                              FontSize="16" FontWeight="Bold"
                              Foreground="{DynamicResource DARKPrimaryText}"
                              HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- 号码选择区域 -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 主号码区域 -->
                        <Border Grid.Row="0" Background="{DynamicResource DARKPrimaryTrans3}" 
                                CornerRadius="10" Padding="15" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{ll:Str 主号码（0-30）}" 
                                         FontSize="18" FontWeight="Bold"
                                         Foreground="{DynamicResource DARKPrimaryText}"
                                         HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                <!-- 6个主号码输入框 -->
                                <UniformGrid Rows="1" Columns="6" HorizontalAlignment="Center">
                                    <pu:NumberInput x:Name="MainNumber1" Width="80" Height="40" 
                                              Minimum="0" Maximum="30" Value="0"
                                              Background="{DynamicResource DARKPrimaryTrans4}"
                                              Foreground="{DynamicResource DARKPrimaryText}"
                                              BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                              BorderThickness="2" FontSize="16" FontWeight="Bold"
                                              Margin="5"/>
                                    <pu:NumberInput x:Name="MainNumber2" Width="80" Height="40" 
                                              Minimum="0" Maximum="30" Value="0"
                                              Background="{DynamicResource DARKPrimaryTrans4}"
                                              Foreground="{DynamicResource DARKPrimaryText}"
                                              BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                              BorderThickness="2" FontSize="16" FontWeight="Bold"
                                              Margin="5"/>
                                    <pu:NumberInput x:Name="MainNumber3" Width="80" Height="40" 
                                              Minimum="0" Maximum="30" Value="0"
                                              Background="{DynamicResource DARKPrimaryTrans4}"
                                              Foreground="{DynamicResource DARKPrimaryText}"
                                              BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                              BorderThickness="2" FontSize="16" FontWeight="Bold"
                                              Margin="5"/>
                                    <pu:NumberInput x:Name="MainNumber4" Width="80" Height="40" 
                                              Minimum="0" Maximum="30" Value="0"
                                              Background="{DynamicResource DARKPrimaryTrans4}"
                                              Foreground="{DynamicResource DARKPrimaryText}"
                                              BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                              BorderThickness="2" FontSize="16" FontWeight="Bold"
                                              Margin="5"/>
                                    <pu:NumberInput x:Name="MainNumber5" Width="80" Height="40" 
                                              Minimum="0" Maximum="30" Value="0"
                                              Background="{DynamicResource DARKPrimaryTrans4}"
                                              Foreground="{DynamicResource DARKPrimaryText}"
                                              BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                              BorderThickness="2" FontSize="16" FontWeight="Bold"
                                              Margin="5"/>
                                    <pu:NumberInput x:Name="MainNumber6" Width="80" Height="40" 
                                              Minimum="0" Maximum="30" Value="0"
                                              Background="{DynamicResource DARKPrimaryTrans4}"
                                              Foreground="{DynamicResource DARKPrimaryText}"
                                              BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                              BorderThickness="2" FontSize="16" FontWeight="Bold"
                                              Margin="5"/>
                                </UniformGrid>

                                <!-- 主号码快速操作 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <Button Content="{ll:Str 主号码机器选号}" 
                                            Click="RandomMainButton_Click" Padding="20,8" Margin="5" 
                                            Background="{DynamicResource DARKPrimaryDarker}" 
                                            Foreground="{DynamicResource DARKPrimaryText}" 
                                            FontWeight="Bold" FontSize="14" MinWidth="100"/>
                                    <Button Content="{ll:Str 清空主号码}" Click="ClearMainNumbers_Click"
                                           Padding="10,5" Margin="5"
                                           Background="{DynamicResource WarningBrush}"
                                           Foreground="{DynamicResource DARKPrimaryText}"
                                           FontSize="12" MinWidth="80"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        
                        <!-- 副号码区域 -->
                        <Border Grid.Column="0" Background="{DynamicResource DARKPrimaryTrans3}" 
                                CornerRadius="10" Padding="15" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{ll:Str 副号码（0-9）}" 
                                         FontSize="18" FontWeight="Bold"
                                         Foreground="{DynamicResource DARKPrimaryText}"
                                         HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                <!-- 2个副号码输入框 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <pu:NumberInput x:Name="SpecialNumber1" Width="80" Height="40" 
                                              Minimum="0" Maximum="9" Value="0"
                                              Background="{DynamicResource DARKPrimaryTrans4}"
                                              Foreground="{DynamicResource DARKPrimaryText}"
                                              BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                              BorderThickness="2" FontSize="16" FontWeight="Bold"
                                              Margin="5"/>
                                    <pu:NumberInput x:Name="SpecialNumber2" Width="80" Height="40" 
                                              Minimum="0" Maximum="9" Value="0"
                                              Background="{DynamicResource DARKPrimaryTrans4}"
                                              Foreground="{DynamicResource DARKPrimaryText}"
                                              BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                              BorderThickness="2" FontSize="16" FontWeight="Bold"
                                              Margin="5"/>
                                </StackPanel>

                                <!-- 副号码快速操作 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                        <Button Content="{ll:Str 副号码机器选号}" 
                                                Click="RandomSpecialButton_Click" Padding="20,8" Margin="5" 
                                                Background="{DynamicResource DARKPrimaryDarker}" 
                                                Foreground="{DynamicResource DARKPrimaryText}" 
                                                FontWeight="Bold" FontSize="14" MinWidth="100"/>
                                        <Button Content="{ll:Str 清空副号码}" Click="ClearSpecialNumbers_Click"
                                           Padding="10,5" Margin="5"
                                           Background="{DynamicResource WarningBrush}"
                                           Foreground="{DynamicResource DARKPrimaryText}"
                                           FontSize="12" MinWidth="80"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--购买选择区-->
                        <Border Grid.Column="1" Background="{DynamicResource DARKPrimaryTrans4}" 
                                CornerRadius="10" Padding="15" Margin="10,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0">
                                    <TextBlock Text="{ll:Str 押币数（最少2代币）：}" 
                                            FontSize="16" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryText}" VerticalAlignment="Center"/>
                                    <pu:NumberInput x:Name="CoinNum" Width="80" Height="40" 
                                        Minimum="2" Value="2"
                                        Background="{DynamicResource DARKPrimaryTrans4}"
                                        Foreground="{DynamicResource DARKPrimaryText}"
                                        BorderBrush="{DynamicResource DARKPrimaryLighter}"
                                        BorderThickness="2" FontSize="16" FontWeight="Bold"
                                        Margin="5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="RandomButton" Content="{ll:Str 机器选号}" 
                                                Click="RandomButton_Click" Padding="20,8" Margin="5" 
                                                Background="{DynamicResource DARKPrimaryDarker}" 
                                                Foreground="{DynamicResource DARKPrimaryText}" 
                                                FontWeight="Bold" FontSize="14" MinWidth="100"/>
                                        <Button Content="{ll:Str 清空所有}" Click="ClearAllNumbers_Click"
                                                Padding="10,5" Margin="5"
                                                Background="{DynamicResource WarningBrush}"
                                                Foreground="{DynamicResource DARKPrimaryText}"
                                                FontSize="12" MinWidth="80"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="{ll:Str 机器选号并购买}" 
                                                Click="RandomBuyButton_Click" Padding="20,8" Margin="5" 
                                                Background="{DynamicResource SuccessBrush}" 
                                                Foreground="{DynamicResource DARKPrimaryText}" 
                                                FontWeight="Bold" FontSize="14" MinWidth="100"/>
                                        <Button Content="{ll:Str 购买彩票}" 
                                                Click="BuyButton_Click" Padding="20,8" Margin="5" 
                                                Background="{DynamicResource SuccessBrush}" 
                                                Foreground="{DynamicResource DARKPrimaryText}" 
                                                FontWeight="Bold" FontSize="14" MinWidth="100"/>
                                    </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="AutoClearByBuy" Content="{ll:Str 购买后自动清空号码}" Margin="5"/>
                                    <CheckBox x:Name="Reminder" Content="{ll:Str 开奖提醒}" Margin="5" Click="Reminder_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Grid>

                    
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="20" Background="{DynamicResource DARKPrimary}"
                CornerRadius="10" BorderBrush="{DynamicResource DARKPrimaryLighter}" 
                BorderThickness="2" Padding="20" Name="ReslutBorder" Visibility="Collapsed">
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height=".4*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{ll:Str 开奖中...}"
                              FontSize="24" FontWeight="Bold"
                              Foreground="{DynamicResource DARKPrimaryText}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                    <controls:LotteryNumberRoller x:Name="NumberRoller" Margin="0,10" Grid.Column="0" Grid.Row="1"/>
                    <TextBlock Grid.Row="2" Text="{ll:Str 您的中奖金额为： 0 代币}" Name="PrizeText"
                          FontSize="24" FontWeight="Bold"
                          Foreground="Gold"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                </Grid>
            </Border>
            <!-- 结果显示区域 -->
            <Border Grid.Row="2" Background="{DynamicResource DARKPrimaryTrans2}" 
                CornerRadius="8" Padding="5" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 中奖信息 -->
                    <TextBlock x:Name="ResultText" Grid.Column="1" 
                         FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource SuccessBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="{ll:Str 每五分钟开奖一次}"/>
                </Grid>
            </Border>

            <Button x:Name="helpButton" 
                    Width="24" Height="24" ToolTip="帮助" 
                    HorizontalAlignment="Left" Margin="16,0,0,0"
                    Click="HelpButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="helpButton_grid">
                                        <Ellipse Fill="{TemplateBinding Background}"/>
                                        <Viewbox Width="24" Height="24">
                                            <Canvas Width="512" Height="512">
                                                <Path Fill="White" 
                                          Data="M437.016,74.984c-99.979-99.979-262.075-99.979-362.033,0.002c-99.978,99.978-99.978,262.073,0.004,362.031 c99.954,99.978,262.05,99.978,362.029-0.002C536.995,337.059,536.995,174.964,437.016,74.984z M406.848,406.844 c-83.318,83.318-218.396,83.318-301.691,0.004c-83.318-83.299-83.318-218.377-0.002-301.693 c83.297-83.317,218.375-83.317,301.691,0S490.162,323.549,406.848,406.844z"/>
                                                <Path Fill="White" 
                                          Data="M271.295,86.684c-53.025-9.308-100.632,31.063-100.632,83.987c0,11.782,9.551,21.333,21.333,21.333 s21.333-9.551,21.333-21.333c0-26.507,23.776-46.67,50.584-41.964c16.882,2.968,31.079,17.165,34.048,34.052 c3.299,18.783-5.487,36.533-21.417,45.315c-26.377,14.544-41.882,43.645-41.882,74.746v37.184 c0,11.782,9.551,21.333,21.333,21.333c11.782,0,21.333-9.551,21.333-21.333V282.82c0-16.217,7.725-30.716,19.816-37.382 c31.705-17.479,49.333-53.091,42.839-90.063C333.906,120.803,305.864,92.761,271.295,86.684z"/>
                                                <Path Fill="White" 
                                          Data="M255.996,384.004c-11.776,0-21.333,9.557-21.333,21.333s9.557,21.333,21.333,21.333c11.776,0,21.333-9.557,21.333-21.333 S267.772,384.004,255.996,384.004z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="helpButton_grid" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="helpButton_grid" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>