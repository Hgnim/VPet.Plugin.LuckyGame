<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<OutputType>Library</OutputType>
		<UseWPF>true</UseWPF>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<AssemblyVersion>2.0.0.0901</AssemblyVersion>
		<FileVersion>2.0.0.0901</FileVersion>
		<VersionPrefix>2.0.0.20260901</VersionPrefix>
		<VersionSuffix></VersionSuffix>

		<Authors>Hgnim, Evian</Authors>
		<Company>$(Authors)</Company>
		<Owners>$(Authors)</Owners>
		<Copyright>Copyright (C) 2025 $(Authors), All rights reserved.</Copyright>
		<PackageLicenseExpression>GPL-3.0</PackageLicenseExpression>
		<Product>LuckyGame</Product>
		<Title>"幸运游戏"桌宠插件</Title>
		<AssemblyTitle>$(Title)</AssemblyTitle>
		<Description>LuckyGame</Description>
		<AssemblyName>VPet.Plugin.LuckyGame</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="VPet-Simulator.Core" Version="1.1.0.66">
			<ExcludeAssets>runtime</ExcludeAssets><!--不复制到输出目录-->
		</PackageReference>
		<PackageReference Include="VPet-Simulator.Windows.Interface" Version="1.1.0.66">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="LinePutScript" Version="1.11.9">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="LinePutScript.Localization.WPF" Version="1.0.7">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <None Update="HelpPage\**">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<!--在输出后只保留win-x64和win-x86的依赖-->
	<!--<Target Name="RuntimeClear" AfterTargets="AfterBuild">	
		<Message Text="开始清理不需要的runtime..." Importance="high" />

		<RemoveDir Directories="$(OutputPath)/runtimes/linux-x64" />
		<RemoveDir Directories="$(OutputPath)/runtimes/osx-x64" />

		<Message Text="runtime清理完成" Importance="high" />
	</Target>-->
	<!--在Release编译时清理无用的输出文件-->
	<!--<Target Name="RemoveOtherFile" AfterTargets="AfterBuild" Condition="'$(Configuration)'=='Release'">
		<Message Text="当前为Release模式，开始清理无用的输出文件..." Importance="high" />

		<Delete Files="$(OutputPath)$(TargetName).pdb"/>
		<Delete Files="$(OutputPath)$(TargetName).deps.json"/>

		<Message Text="无用文件清理完成" Importance="high" />
	</Target>-->

	<!--自动下载所需要的js模块至项目-->
	<Target Name="DownloadJsModules" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<!-- 为每个文件添加 DestinationFolder 元数据 -->
			<FilesToDownload Include="marked.umd.js">
				<!--https://github.com/markedjs/marked-->
				<Url>https://cdn.jsdelivr.net/npm/marked@v17.0.1/lib/marked.umd.js</Url>
				<DestinationFolder>$(MSBuildProjectDirectory)\HelpPage\local_modules\marked</DestinationFolder>
			</FilesToDownload>

			<!--备注：添加更多需下载文件的示例
			<FilesToDownload Include="xxx1">
				<Url>https://example.com/xxx1</Url>
				<DestinationFolder>$(MSBuildProjectDirectory)\test1</DestinationFolder>
			</FilesToDownload>

			<FilesToDownload Include="xxx2">
				<Url>https://example.com/xxx2</Url>
				<DestinationFolder>$(MSBuildProjectDirectory)\test2</DestinationFolder>
			</FilesToDownload>
			-->
		</ItemGroup>

		<!--检查并创建所需文件夹-->
		<MakeDir Directories="%(FilesToDownload.DestinationFolder)" Condition="!Exists('%(FilesToDownload.DestinationFolder)')" />

		<Message Text="开始下载js模块: %(FilesToDownload.Url) -&gt; %(FilesToDownload.DestinationFolder)\%(FilesToDownload.Identity)" Condition="!Exists('%(FilesToDownload.DestinationFolder)\%(FilesToDownload.Identity)')" Importance="high" />
		
		<!--下载文件，且当文件存在时不会执行下载。如需更新，删除本地文件并构建即可-->
		<DownloadFile SourceUrl="%(FilesToDownload.Url)" DestinationFolder="%(FilesToDownload.DestinationFolder)" DestinationFileName="%(FilesToDownload.Identity)" Condition="!Exists('%(FilesToDownload.DestinationFolder)\%(FilesToDownload.Identity)')" SkipUnchangedFiles="true">
			<Output TaskParameter="DownloadedFile" ItemName="Content" />
		</DownloadFile>
		
		<Message Text="js模块存在: %(FilesToDownload.DestinationFolder)\%(FilesToDownload.Identity)" Condition="Exists('%(FilesToDownload.DestinationFolder)\%(FilesToDownload.Identity)')" Importance="high" />
	</Target>
</Project>